# Raw scraped HTML lives on the PC, outside git — never committed (caller contract clause 3).
*.html
# Exception: committed zero-fetch test fixtures (archived samples, not live-scraped).
!tests/samples/*.html

# Python noise
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
run_full_backfill.py

# Derived analysis caches: regenerable from games/** in seconds, so they are
# built not committed -- the same argument that keeps `_derived` out of
# semantic equality.
artifacts/derived/

# Spike intermediates: per-row OOF prediction / residual matrices over ~100k
# plate appearances. Regenerable by re-running the fit that wrote them, read
# only by sibling spikes at runtime, and 34 MB between them -- an order of
# magnitude more than the entire rest of the modelling line. The small
# latent.npz / core.npz / effects.npz ARE committed: they are the fitted model
# state a board number is pinned to, not a cache.
spikes/pitch/step3_oof.npz
spikes/npmr/residuals.npz
spikes/gllvm/residuals.npz
spikes/glmm/residuals.npz

# spikes/advance builds a 73 MB per-PA record cache from games/** in ~1 minute;
# regenerable, read only by that spike -- same argument as the OOF matrices above.
spikes/advance/records_cache.json
